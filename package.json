{
  "name": "onyxhub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 4400",
    "build": "next build",
    "start": "next start -p 4400",
