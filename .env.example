# Toutes ces variables sont facultatives : sans elles, OnyxHub se configure
# depuis la page de connexion (adresse d'Onyx) puis depuis Réglages.

# Adresse du serveur Onyx. Recommandée : si elle est définie, la page de
# connexion ne la demande pas et Réglages l'affiche verrouillée.
# ONYX_URL=http://192.168.1.10:8080

# Clé que le serveur Onyx présente pour envoyer les demandes (ADR-0002).
# Sinon, générée depuis Réglages.
# ONYXHUB_INTEGRATION_KEY=

# Clé de chiffrement des secrets et du cookie de session (32 caractères min).
# Sinon, un fichier data/secret.key est créé au premier démarrage.
# La changer déconnecte tout le monde et oblige à ressaisir les secrets.
# ONYXHUB_SECRET=

# Dossier des données (base SQLite, clé, cache des affiches). Défaut : ./data
# ONYXHUB_DATA_DIR=/data

# API TMDB à utiliser à la place de https://api.themoviedb.org/3 (miroir,
# ou faux TMDB local pour vérifier l'interface sans clé).
# TMDB_API_URL=

# --- Docker (docker-compose.yml) ---
# Propriétaire des fichiers de ./data sur l'hôte (Unraid : 99 et 100).
# PUID=1000
# PGID=1000
# Port publié sur l'hôte.
# ONYXHUB_PORT=4400
# Image à tirer : ghcr.io/<GITHUB_OWNER>/onyxhub:<ONYXHUB_TAG>.
# GITHUB_OWNER=tsuky44
# ONYXHUB_TAG=latest
# Fuseau horaire (jours du calendrier, dates).
# TZ=Europe/Paris
